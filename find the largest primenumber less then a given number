def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5)+1):
        if n % i == 0:
            return False
    return True

num = int(input("Enter a number: "))

for i in range(num - 1, 1, -1):
    if is_prime(i):
        print("The largest prime number less than", num, "is:", i)
        break
else:
    print("No prime number found.")
