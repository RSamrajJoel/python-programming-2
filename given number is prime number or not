num = int(input("Enter a number: "))
if num <= 1:
    print(f"{num} is NOT a prime number.")
else:
    is_prime = True
    for i in range(2, num):  
        if num % i == 0:
            is_prime = False
            break
    print(f"{num} is {'a prime number.' if is_prime else 'NOT a prime number.'}")
